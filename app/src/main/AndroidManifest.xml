<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet / AI API / web features -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice assistant -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera and image understanding -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- File access for older Android versions -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Foreground voice-assistant service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Allow GOD to discover launchable installed apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GOD">

        <!-- Main GOD screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- AI Provider / API configuration screen -->
        <activity
            android:name=".AIProviderActivity"
            android:exported="false" />

    </application>

</manifest>
