<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========================= -->
    <!-- INTERNET / AI / WEB ACCESS -->
    <!-- ========================= -->

    <!-- Required for AI APIs and current-information/web features -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ========================= -->
    <!-- MICROPHONE / VOICE        -->
    <!-- ========================= -->

    <!-- Used for voice commands and speech recognition -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ========================= -->
    <!-- NOTIFICATIONS              -->
    <!-- ========================= -->

    <!-- Used for GOD notifications and foreground services on newer Android versions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ========================= -->
    <!-- FILE ACCESS                -->
    <!-- ========================= -->

    <!-- Legacy external-storage access for older Android versions -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ========================= -->
    <!-- CAMERA                     -->
    <!-- ========================= -->

    <!-- Used for camera/image understanding features -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ========================= -->
    <!-- FOREGROUND SERVICES       -->
    <!-- ========================= -->

    <!-- Allows long-running voice/assistant work when Android permits it -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Required for microphone foreground-service operation on supported Android versions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- ========================= -->
    <!-- APP INFORMATION            -->
    <!-- ========================= -->

    <!-- Allows the app to determine compatible launchable apps.
         Actual app launching will use Android's official Intent APIs. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- ========================= -->
    <!-- APPLICATION                -->
    <!-- ========================= -->

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GOD">

        <!-- ========================= -->
        <!-- MAIN GOD ACTIVITY          -->
        <!-- ========================= -->

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
